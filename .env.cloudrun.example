# 微信云托管控制台环境变量模板。真实密码只填在控制台，不提交。
# 现有服务不会自动读取此文件，逐项录入控制台“服务设置”。
ASPNETCORE_ENVIRONMENT=Production
PORT=80
MYSQL_ADDRESS=10.40.100.75:3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=fill_in_the_password_you_provided
MYSQL_DATABASE=vegetable_prod
MYSQL_ALLOW_ROOT=true
MYSQL_POOL_LIMIT=10
MYSQL_SSL_MODE=Preferred
BUSINESS_TIME_ZONE=Asia/Shanghai
DEV_LOGIN_ENABLED=false
# 微信真实登录另需设置 WECHAT_APP_ID 和 WECHAT_APP_SECRET。
