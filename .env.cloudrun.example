# 微信云托管控制台环境变量模板。真实密码只填在控制台，不提交。
# 现有服务不会自动读取此文件，逐项录入控制台“服务设置”。
ASPNETCORE_ENVIRONMENT=Production
PORT=80
MYSQL_ADDRESS=10.40.100.75:3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=fill_in_the_password_you_provided
MYSQL_DATABASE=vegetable_prod
MYSQL_ALLOW_ROOT=true
MYSQL_POOL_LIMIT=10
MYSQL_SSL_MODE=Preferred
BUSINESS_TIME_ZONE=Asia/Shanghai
DEV_LOGIN_ENABLED=false
# 微信登录与手机号核实：两项均在云控制台填写，保存后部署/重启使其生效。
WECHAT_APP_ID=wx336b5ac8bed80159
# 从此小程序管理平台的“开发设置”获取，只填云控制台，不提交真实值。
WECHAT_APP_SECRET=fill_in_this_miniprograms_appsecret

# 管理员订阅模板74963“库存更新提醒”；代码已默认使用，旧空值需删除或填入下列值。
WECHAT_NOTIFICATION_TEMPLATE_ID=qYyaJOr5BwwRMldhCHEBqhefy7wIvcsNsibhxWA1vrw
# 操作人、更新时间、温馨提示；控制台值不带外层单引号。
WECHAT_NOTIFICATION_FIELDS='{"thing8":"actor","time3":"time","thing4":"summary"}'
# 体验版使用trial，正式发布后改为formal并部署/重启。
WECHAT_NOTIFICATION_STATE=trial
