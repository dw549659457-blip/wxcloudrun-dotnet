# 占位符模板；勿填真实生产密码后提交。变量由脚本显式加载，控制台变量直接注入。
ASPNETCORE_ENVIRONMENT=Development
PORT=8080
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vegetable_dev
MYSQL_USER=your_database_user
MYSQL_PASSWORD=your_database_password
# 生产默认拒绝 root。明确使用现有托管 root 时才能设为 true。
MYSQL_ALLOW_ROOT=false
MYSQL_POOL_LIMIT=10
MYSQL_SSL_MODE=Preferred
MYSQL_SSL_CA_FILE=
# 与 MYSQL_HOST/PORT 和 MYSQL_USER 同时设置时必须一致，支持原模板名称：
# MYSQL_ADDRESS=your_mysql_host:3306
# MYSQL_USERNAME=your_database_user
BUSINESS_TIME_ZONE=Asia/Shanghai
REQUEST_TIMEOUT_SECONDS=30
TRUSTED_PROXIES=
DEV_LOGIN_ENABLED=false
DEV_SEED_PASSWORD=choose_a_local_only_password_at_least_12_characters
INITIAL_ADMIN_USERNAME=your_initial_admin_username
INITIAL_ADMIN_PASSWORD=choose_a_unique_production_password_at_least_12_characters
WECHAT_APP_ID=your_wechat_appid
WECHAT_APP_SECRET=your_wechat_app_secret
WECHAT_TOKEN_MODE=standard
