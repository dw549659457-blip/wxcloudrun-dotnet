.quantity-card {
  padding: 10px;
  margin: 8px 0;
  border: 1px solid #d3e0cf;
  border-radius: 12px;
  background: white;
  font-size: 18px;
  color: #20382b;
  box-sizing: border-box;
  line-height: 1.45;
  overflow-wrap: anywhere;
}
.choice {
  padding: 10px 8px;
  min-height: 48px;
  box-sizing: border-box;
  font-size: 20px;
  font-weight: 600;
}
.quantity-controls {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 4px;
}
.step-button {
  flex: 0 0 48px;
  width: 48px;
  min-height: 52px;
  padding: 0;
  margin: 0;
  font-size: 24px;
  background: #edf5e9;
  color: #26462d;
  line-height: 52px;
  border-radius: 12px;
}
.quantity-input {
  flex: 1;
  min-width: 0;
  font-size: 24px;
  border: 1px solid #aebfaf;
  border-radius: 12px;
  padding: 8px;
  height: 52px;
  line-height: 1.4;
  box-sizing: border-box;
  color: #176747;
  font-weight: 600;
  text-align: center;
}
.unit {
  font-size: 18px;
  color: #39583d;
}
.remove {
  font-size: 18px;
  min-height: 48px;
  line-height: 1.4;
  background: #fff2ed;
  color: #7e3528;
  margin: 0;
  padding: 4px 10px;
}

.type-choices {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.type-option {
  width: calc(50% - 4px);
  box-sizing: border-box;
  font-size: 20px;
  min-height: 54px;
  line-height: 1.4;
  padding: 8px;
  margin: 0;
  background: white;
  color: #26462d;
  white-space: normal;
  border-radius: 12px;
  word-break: break-word;
  overflow-wrap: anywhere;
}
.type-choices .selected-type {
  border: 2px solid #176747;
  background: #edf6e9;
}
.quantity-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-top: 6px;
}
.quantity-label {
  font-size: 18px;
  color: #39583d;
}
.selected-label {
  font-size: 18px;
  color: #176747;
  font-weight: 600;
}
.type-option::after,
.step-button::after {
  border: 1px solid #cddccb;
  border-radius: 12px;
}
.type-choices .selected-type::after,
.remove::after {
  border: 0;
}
.remove {
  width: auto;
  flex: 0 0 auto;
  border-radius: 10px;
  font-weight: 400;
}
.step-button.control-disabled,
.type-option.control-disabled {
  color: #617161;
  background: #edf0e9;
}
