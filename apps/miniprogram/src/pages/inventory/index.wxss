.inventory-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}
.inventory-toolbar .title {
  margin-bottom: 0;
}
.inventory-toolbar button {
  flex: 0 0 auto;
  width: auto;
  min-width: 76px;
}
.inventory-list {
  margin-top: 10px;
  padding: 0 12px;
  background: #fff;
  border: 1px solid #dce7dc;
  border-radius: 14px;
}
.inventory-row {
  display: block;
  min-height: 58px;
  padding: 8px 0;
  border-bottom: 1px solid #edf1eb;
}
.inventory-row:last-child {
  border-bottom: 0;
}
.inventory-name {
  font-size: 20px;
  font-weight: 600;
  overflow-wrap: anywhere;
}
.inventory-name .status {
  margin-left: 5px;
  font-size: 16px;
}
.inventory-value {
  margin-top: 2px;
  font-size: 24px;
  line-height: 1.3;
  text-align: left;
}
.inventory-unit {
  margin-left: 4px;
  font-size: 18px;
  font-weight: 400;
}
