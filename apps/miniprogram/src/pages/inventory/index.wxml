<view class="page">
  <view class="inventory-toolbar"><view class="title">{{title}}</view><button class="secondary" bindtap="load" disabled="{{loading}}" loading="{{loading}}">{{loading ? '查询中' : '刷新'}}</button></view>
  <view wx:if="{{error}}" class="error">{{error}}</view><view class="inventory-list"><view wx:for="{{rows}}" wx:key="id" class="inventory-row"><view class="inventory-name">{{item.name}}<text class="status status-closed" wx:if="{{!item.enabled}}">已停用</text></view><view class="quantity inventory-value">{{item.quantity}}<text class="inventory-unit">{{item.unit}}</text></view></view></view>
  <view wx:if="{{!loading && !error && !rows.length}}" class="empty"><view class="empty-title">暂无库存记录</view></view>
  <view class="row-actions pagination"><button bindtap="previous" disabled="{{loading || page === 1}}">上一页</button><view class="page-number">第 {{page}} 页</view><button bindtap="next" disabled="{{loading || !canNext}}">下一页</button></view>
</view>
