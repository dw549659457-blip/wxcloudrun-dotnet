<view class="page"
  ><view class="title">蔬菜库存</view
  ><view class="subtitle">按品类与单位分别显示，提交前会再次核对。</view
  ><button class="primary" bindtap="load" disabled="{{loading}}">刷新库存</button
  ><view wx:if="{{loading}}" class="notice">正在查询库存…</view
  ><view wx:if="{{error}}" class="error">{{error}}</view
  ><view wx:for="{{rows}}" wx:key="id" class="card"
    ><view class="card-title">{{item.name}}</view
    ><view class="quantity">{{item.quantity}} {{item.unit}}</view
    ><view wx:if="{{!item.enabled}}">此品类已停用</view></view
  ><view wx:if="{{!loading && !error && !rows.length}}" class="empty">当前没有蔬菜库存记录。</view
  ><view class="row-actions"
    ><button bindtap="previous" disabled="{{loading || page === 1}}">上一页</button
    ><view>第 {{page}} 页</view
    ><button bindtap="next" disabled="{{loading || !canNext}}">下一页</button></view
  ></view
>
