<view class="page">
  <view class="title">{{title}}</view><view class="subtitle">按品类、单位查看当前可出库数量。</view><button class="primary" bindtap="load" disabled="{{loading}}" loading="{{loading}}">{{loading ? '正在查询库存…' : '刷新库存'}}</button>
  <view wx:if="{{error}}" class="error">{{error}}</view><view class="inventory-list"><view wx:for="{{rows}}" wx:key="id" class="card inventory-card"><view class="card-heading"><view class="card-title">{{item.name}}</view><text class="status status-closed" wx:if="{{!item.enabled}}">已停用</text></view><view class="caption">当前库存</view><view class="quantity inventory-value">{{item.quantity}}<text class="inventory-unit">{{item.unit}}</text></view></view></view>
  <view wx:if="{{!loading && !error && !rows.length}}" class="empty"><view class="empty-title">暂无库存记录</view><view>库存入账后，可以在这里查看。</view></view>
  <view class="row-actions pagination"><button bindtap="previous" disabled="{{loading || page === 1}}">上一页</button><view class="page-number">第 {{page}} 页</view><button bindtap="next" disabled="{{loading || !canNext}}">下一页</button></view><view class="page-footer">提交出库前，后台会再次核对库存。</view>
</view>
