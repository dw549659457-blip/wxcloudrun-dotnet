<view class="page">
  <view class="title">我的{{title}}记录</view>
  <view class="card"><view class="card-title">筛选日期</view><view class="row-actions date-filters"><picker mode="date" value="{{from}}" data-field="from" bindchange="date"><view class="field-label">开始</view><view class="picker">{{from || '选择日期'}}</view></picker><picker mode="date" value="{{to}}" data-field="to" bindchange="date"><view class="field-label">结束</view><view class="picker">{{to || '选择日期'}}</view></picker></view><button class="link-button" bindtap="clear">清空筛选</button></view>
  <view wx:if="{{loading}}" class="notice">正在加载记录…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view>
  <view class="empty" wx:if="{{!loading && !error && !rows.length}}"><view class="empty-title">暂无记录</view><view>可调整日期后再查。</view></view>
  <view wx:for="{{rows}}" wx:key="id" class="card record-card"><view class="card-heading"><view class="card-title">{{item.input.businessDate}}</view><text class="status {{item.status === 'DRAFT' ? 'status-draft' : item.status === 'REVERSED' ? 'status-closed' : ''}}">{{item.statusText}}</text></view><view class="meta-line">{{item.creatorName}}<text wx:if="{{item.input.mode === 'DIRECT'}}"> · 手工出库</text></view><view class="record-number">{{item.number}}</view><button class="secondary" data-id="{{item.id}}" bindtap="detail">查看详情</button></view>
  <view class="row-actions pagination"><button bindtap="previous" disabled="{{page === 1 || loading}}">上一页</button><view class="page-number">第 {{page}} 页</view><button bindtap="next" disabled="{{!canNext || loading}}">下一页</button></view>
</view>
