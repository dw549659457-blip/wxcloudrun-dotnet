<view class="page"
  ><view class="title">我的{{title}}记录</view
  ><view class="subtitle">只展示本人记录，可查询以前的日期。</view
  ><view class="row-actions"
    ><picker mode="date" value="{{from}}" data-field="from" bindchange="date"
      ><view class="picker">{{from || '起始日期'}}</view></picker
    ><picker mode="date" value="{{to}}" data-field="to" bindchange="date"
      ><view class="picker">{{to || '结束日期'}}</view></picker
    ></view
  ><button class="link-button" bindtap="clear">清空日期，查看全部</button
  ><view wx:if="{{loading}}" class="notice">正在加载记录…</view
  ><view wx:if="{{error}}" class="error">{{error}}<button bindtap="load">重新加载</button></view
  ><view class="empty" wx:if="{{!loading && !error && !rows.length}}">还没有符合条件的记录。</view
  ><view wx:for="{{rows}}" wx:key="id" class="card"
    ><view class="card-title">{{item.input.businessDate}} · {{item.statusText}}</view
    ><view>记录人：{{item.creatorName}}</view
    ><view class="record-number">单据号：{{item.number}}</view
    ><view>创建：{{item.createdText}}</view><view>提交：{{item.postedText}}</view
    ><view wx:if="{{item.input.mode === 'DIRECT'}}" class="warning">手工出库，报表数量为负</view
    ><button data-id="{{item.id}}" bindtap="detail">查看这笔记录</button></view
  ><view class="row-actions"
    ><button bindtap="previous" disabled="{{page === 1 || loading}}">上一页</button
    ><view>第 {{page}} 页</view
    ><button bindtap="next" disabled="{{!canNext || loading}}">下一页</button></view
  ></view
>
