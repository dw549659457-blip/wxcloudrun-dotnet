<view class="page"
  ><view class="title">{{target === 'view' ? '我的棚户任务' : '选择棚户任务'}}</view
  ><view class="subtitle">核对姓名、派发日期和司机，再点对应大卡片。</view
  ><view class="field"
    ><input
      value="{{search}}"
      bindinput="searchInput"
      placeholder="输入棚户姓名搜索"
      confirm-type="search"
      bindconfirm="search"
    /><button class="primary" bindtap="search" disabled="{{loading}}">搜索棚户</button></view
  ><view class="notice" wx:if="{{loading}}">正在加载棚户任务…</view
  ><view class="error" wx:if="{{error}}">{{error}}<button bindtap="load">重新加载</button></view
  ><view class="empty" wx:if="{{!loading && !error && !rows.length}}"
    >没有符合条件的任务。可清空姓名重新查询。</view
  ><button
    wx:for="{{rows}}"
    wx:key="id"
    class="card batch-choice"
    data-id="{{item.id}}"
    bindtap="choose"
  >
    <view class="card-title">{{item.growerName}}</view
    ><view>派发 {{item.date}} · 司机{{item.driverName}}</view
    ><view class="status">{{item.statusText}}</view><view>{{item.packagingText}}</view></button
  ><view class="row-actions"
    ><button bindtap="previous" disabled="{{loading || page === 1}}">上一页</button
    ><view class="caption">第 {{page}} 页</view
    ><button bindtap="next" disabled="{{loading || !canNext}}">下一页</button></view
  ><view id="batch-detail" wx:if="{{selected}}" class="card"
    ><view class="card-title">{{selected.batch.growerName}}对账</view
    ><view wx:for="{{selected.packaging}}" wx:key="itemId" class="summary-line"
      >{{item.name}}（{{item.unit}}）<view>派发 {{item.dispatched}} · 消耗 {{item.consumed}}</view
      ><view>回收 {{item.recovered}} · 损耗 {{item.lost}} · 在外 {{item.outstanding}}</view></view
    ><view wx:for="{{selected.vegetables}}" wx:key="itemId" class="summary-line"
      >{{item.name}}：装菜 {{item.output}} · 实收 {{item.received}} · 差异 {{item.difference}}
      {{item.unit}}</view
    ></view
  ></view
>
