.batch-choice {
  display: block;
  width: 100%;
  text-align: left;
  font-weight: 400;
  font-size: 18px;
  padding: 18px;
  box-sizing: border-box;
  line-height: 1.7;
}
.search-card button {
  margin-top: 12px;
}
.batch-packaging {
  margin-top: 12px;
  padding: 10px 12px;
  background: #f5f8f3;
  border-radius: 10px;
  overflow-wrap: anywhere;
}
.batch-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #176747;
  font-weight: 600;
  margin-top: 14px;
}
.batch-cta text {
  font-size: 28px;
}
.batch-detail {
  margin-top: 24px;
}
