.batch-choice {
  display: block;
  width: 100%;
  text-align: left;
  font-weight: 400;
  font-size: 18px;
  padding: 14px;
  box-sizing: border-box;
  line-height: 1.5;
}
.search-card button {
  margin-top: 12px;
}
.batch-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #176747;
  font-weight: 600;
  margin-top: 6px;
}
.batch-cta text {
  font-size: 28px;
}
.batch-detail {
  margin-top: 14px;
}
