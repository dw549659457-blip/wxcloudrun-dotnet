.identity-card {
  display: flex;
  align-items: center;
  gap: 14px;
}
.identity-mark {
  flex: 0 0 50px;
  width: 50px;
  height: 50px;
  border-radius: 15px;
  background: #edf5e9;
  color: #176747;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  font-weight: 700;
}
.identity-copy {
  flex: 1;
  min-width: 0;
}
.identity-copy .card-title {
  margin-bottom: 4px;
}
.role-choice {
  justify-content: space-between;
  gap: 12px;
}
.role-current {
  flex-shrink: 0;
  color: #176747;
  font-size: 18px;
}
