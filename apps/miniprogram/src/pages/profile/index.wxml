<view class="page"
  ><view class="title">我的身份</view
  ><view class="card"
    ><view class="card-title">{{name}}</view
    ><view>身份由管理员登记。如姓名或权限有误，请联系管理员。</view></view
  ><view wx:if="{{error}}" class="error">{{error}}</view
  ><view class="section-title">选择本次身份</view
  ><button
    wx:for="{{roles}}"
    wx:key="value"
    class="{{role === item.value ? 'selected' : ''}}"
    data-role="{{item.value}}"
    bindtap="select"
    disabled="{{busy}}"
  >
    {{item.label}}{{role === item.value ? '（当前）' : ''}}</button
  ><view class="actions"
    ><button class="primary" bindtap="help">操作帮助与常见问题</button
    ><button class="danger" bindtap="exit">退出账号</button></view
  ></view
>
