<view class="page">
  <view class="title">我的身份</view><view class="card identity-card"><view class="identity-mark" aria-hidden="true">我</view><view class="identity-copy"><view class="card-title">{{name || '正在核实身份…'}}</view><view class="caption">员工身份由管理员登记</view></view></view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="section-title">选择本次岗位</view><view class="caption">多岗位员工可在这里切换，后续记账使用选中的岗位。</view><view class="actions"><button wx:for="{{roles}}" wx:key="value" class="role-choice {{role === item.value ? 'selected' : ''}}" data-role="{{item.value}}" bindtap="select" disabled="{{busy}}"><text>{{item.label}}</text><text class="role-current" wx:if="{{role === item.value}}">✓ 当前</text></button></view>
  <view class="notice">姓名或岗位有误，请联系管理员核实。</view><view class="actions"><button class="primary" bindtap="help">操作帮助与常见问题</button><button class="link-button danger" bindtap="exit" disabled="{{busy}}">退出账号</button></view><view class="page-footer">棚户记账 · 版本 {{version}}</view>
</view>
