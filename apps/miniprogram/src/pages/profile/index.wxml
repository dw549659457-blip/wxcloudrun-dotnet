<view class="page">
  <view class="title">我的身份</view><view class="card identity-card"><view class="identity-mark" aria-hidden="true">我</view><view class="identity-copy"><view class="card-title">{{name || '正在核实身份…'}}</view></view></view><view wx:if="{{error}}" class="error">{{error}}</view>
  <view class="section-title">本次岗位</view><view class="actions"><button wx:for="{{roles}}" wx:key="value" class="role-choice {{role === item.value ? 'selected' : ''}}" data-role="{{item.value}}" bindtap="select" disabled="{{busy}}"><text>{{item.label}}</text><text class="role-current" wx:if="{{role === item.value}}">✓ 当前</text></button></view>
  <view class="actions"><button class="secondary" bindtap="help">操作帮助</button><button class="link-button danger" bindtap="exit" disabled="{{busy}}">退出账号</button></view><view class="page-footer">棚户记账 · 版本 {{version}}</view>
</view>
