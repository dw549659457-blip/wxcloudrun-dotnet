<view class="page"><view class="title">本次变动详情</view><view class="notice" wx:if="{{loading}}">正在加载动态…</view><view class="error" wx:if="{{error}}">{{error}}<button bindtap="load">重新加载</button></view><view class="warning" wx:if="{{notice}}">{{notice}}</view><view wx:if="{{detail}}"><view class="card"><view class="card-title">{{detail.title}}</view><view>{{detail.actor}}<text wx:if="{{detail.party}}"> · {{detail.party}}</text></view><view>{{detail.businessDate}} · {{detail.time}}</view><view class="record-number">{{detail.number}}</view></view><view class="caption">本次入账时的库存快照</view><view wx:for="{{detail.lines}}" wx:key="key" class="card"><view class="card-title">{{item.name}} · {{item.label}}</view><view class="quantity">{{item.deltaText}} {{item.unit}}</view><view class="caption" wx:if="{{item.balance !== null}}">当时库存 {{item.balanceText}} {{item.unit}}</view></view></view><view class="actions"><button bindtap="inventory">当前蔬菜库存</button><button class="primary" bindtap="home">返回工作台</button></view></view>
