<view class="page"><view class="title">本次变动详情</view><view class="notice" wx:if="{{loading}}">正在加载动态…</view><view class="error" wx:if="{{error}}">{{error}}<button bindtap="load">重新加载</button></view><view class="warning" wx:if="{{notice}}">{{notice}}</view><view wx:if="{{detail}}"><view class="card"><view class="card-title">{{detail.title}}</view><view>操作人：{{detail.actor}}</view><view wx:if="{{detail.party}}">棚户 / 客户：{{detail.party}}</view><view>业务日期：{{detail.businessDate}}</view><view class="caption">入账时间：{{detail.time}}</view><view class="record-number">{{detail.number}}</view></view><view class="notice">以下是这笔入账当时的变动与库存快照。后续库存请点“查看当前库存”。装菜产出尚未进入仓库。</view><view wx:for="{{detail.lines}}" wx:key="key" class="card"><view class="card-title">{{item.name}}</view><text class="status">{{item.label}}</text><view class="quantity">{{item.deltaText}} {{item.unit}}</view><view class="caption" wx:if="{{item.balance !== null}}">入账时仓库库存：{{item.balanceText}} {{item.unit}}</view></view></view><view class="actions"><button bindtap="inventory">查看当前蔬菜库存</button><button class="primary" bindtap="home">返回管理员工作台</button></view></view>
