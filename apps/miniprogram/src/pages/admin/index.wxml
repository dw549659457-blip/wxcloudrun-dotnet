<view class="page">
  <view class="admin-hero"><view class="title">{{name || '管理员'}}，您好</view></view>
  <view class="notice" wx:if="{{loading}}">正在加载库存与动态…</view>
  <view class="error" wx:if="{{error}}">{{error}}<button bindtap="onShow" disabled="{{busy}}">重新进入工作台</button></view>
  <view class="notice" wx:if="{{notice}}">{{notice}}</view>
  <view class="card"><view class="card-title">{{unreadCount}} 条未读动态</view><view class="caption" wx:if="{{lastUpdated}}">更新于 {{lastUpdated}}</view><view class="row-actions"><button bindtap="reload" disabled="{{loading || busy}}">刷新</button><button bindtap="readAll" disabled="{{!latestId || busy || loading}}">全部已读</button></view></view>
  <view class="section-title">最新动态</view>
  <button class="primary" wx:if="{{newCount}}" bindtap="reload">有新动态，点击查看</button>
  <view class="empty" wx:if="{{!items.length && !loading}}"><view class="empty-title">暂无动态</view></view>
  <button wx:for="{{items}}" wx:key="id" class="notification-card" data-id="{{item.notification.id}}" bindtap="detail"><view class="card-heading"><view class="card-title">{{item.notification.title}}</view><text class="status {{item.isRead ? '' : 'unread'}}">{{item.isRead ? '已读' : '未读'}}</text></view><view>{{item.notification.actor}}<text wx:if="{{item.notification.party}}"> · {{item.notification.party}}</text></view><view class="caption">{{item.notification.time}}</view><view class="notification-line" wx:for="{{item.notification.lines}}" wx:for-item="line" wx:key="key"><view>{{line.name}} · {{line.label}}</view><view class="stock-value">{{line.deltaText}} {{line.unit}}</view></view><view class="detail-link">查看详情 ›</view></button>
  <button wx:if="{{hasMore}}" bindtap="more" disabled="{{busy}}" loading="{{busy}}">查看更多历史动态</button>
  <view class="section-title">仓库库存</view>
  <view class="card"><view class="card-title">蔬菜</view><view class="stock-row" wx:for="{{vegetables}}" wx:key="id"><view>{{item.name}}</view><view class="stock-value">{{item.quantity}} {{item.unit}}</view></view><view class="caption" wx:if="{{!vegetables.length}}">暂无蔬菜库存</view><button class="link-button" data-domain="vegetables" bindtap="inventory">查看全部蔬菜库存 ›</button></view>
  <view class="card"><view class="card-title">仓库包装</view><view class="stock-row" wx:for="{{packaging}}" wx:key="id"><view>{{item.name}}</view><view class="stock-value">{{item.quantity}} {{item.unit}}</view></view><view class="caption" wx:if="{{!packaging.length}}">暂无包装库存</view><button class="link-button" data-domain="packaging" bindtap="inventory">查看全部包装库存 ›</button></view>
  <view class="card" wx:if="{{subscription}}"><view class="card-title">微信服务通知</view><view class="caption" wx:if="{{deliveryText}}">{{deliveryText}}</view><view class="caption" wx:if="{{subscription.lastDelivery && subscription.lastDelivery.state === 'FAILED' && subscription.lastDelivery.errorCode !== null}}">微信返回码：{{subscription.lastDelivery.errorCode}}</view><view class="warning" wx:if="{{!subscription.configured}}">{{subscription.configurationError || '微信模板尚未配置，小程序内动态正常使用。'}}</view><view class="notice" wx:if="{{subscription.paused}}">微信提醒已暂停。</view><view class="caption" wx:if="{{subscription.recordedSubscriptions}}">已登记 {{subscription.recordedSubscriptions}} 次订阅</view><view class="warning" wx:if="{{subscription.lastDelivery && subscription.lastDelivery.errorCode === 43101}}">微信授权已不足，请重新订阅。</view><view class="warning" wx:if="{{subscription.lastDelivery && subscription.lastDelivery.state === 'UNCERTAIN'}}">上一条微信通知送达结果未确认，请在上方查看完整动态。</view><view class="actions" wx:if="{{subscription.configured || pendingSubscription}}"><button class="primary" wx:if="{{subscription.configured}}" bindtap="subscribe" disabled="{{busy || pendingSubscription}}">订阅下一次微信提醒</button><button bindtap="sync" wx:if="{{pendingSubscription}}" disabled="{{busy}}">同步订阅结果</button><button class="link-button" wx:if="{{pendingSubscription}}" bindtap="discardPending" disabled="{{busy}}">放弃本机待同步登记</button><button class="link-button" wx:if="{{subscription.configured}}" bindtap="pause" disabled="{{busy}}">{{subscription.paused ? '恢复微信提醒' : '暂停微信提醒'}}</button></view></view>
  <button class="link-button" bindtap="profile">我的身份与岗位切换</button>
</view>
