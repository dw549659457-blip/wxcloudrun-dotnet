.home-hero {
  padding: 16px 18px;
  border-radius: 16px;
  background: #176747;
  color: #fff;
  box-shadow: 0 4px 12px rgba(23, 103, 71, 0.12);
}
.home-caption {
  font-size: 16px;
  color: #eef7e9;
}
.home-identity {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8px;
  margin: 6px 0 0;
}
.home-name {
  font-size: 24px;
  line-height: 1.4;
  font-weight: 700;
  overflow-wrap: anywhere;
}
.role-badge {
  padding: 2px 8px;
  border-radius: 9px;
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  font-size: 16px;
}
.task-overview {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  margin-top: 10px;
  background: #eaf4e9;
  border: 1px solid #c4dfc3;
  border-radius: 14px;
}
.overview-label {
  font-size: 18px;
  font-weight: 700;
}
.overview-count {
  flex-shrink: 0;
  color: #176747;
  font-size: 30px;
  font-weight: 700;
  line-height: 1.3;
}
.overview-count text {
  font-size: 16px;
  font-weight: 400;
  margin-left: 6px;
}
.task-button {
  display: flex;
  width: 100%;
  min-height: 72px;
  padding: 10px 14px;
  justify-content: flex-start;
  text-align: left;
}
.task-copy {
  width: 100%;
  min-width: 0;
}
.task-title {
  font-size: 21px;
  line-height: 1.35;
}
.task-description {
  font-size: 16px;
  font-weight: 400;
  color: #51664f;
  line-height: 1.5;
  margin-top: 2px;
}
.primary .task-description {
  color: #eef7e9;
}
.shortcut-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}
.shortcut-grid button {
  width: calc(50% - 4px);
  min-height: 56px;
  font-size: 18px;
  padding: 8px;
}
.pending-task {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
  padding: 12px 14px;
  margin-bottom: 8px;
  text-align: left;
}
.pending-copy {
  flex: 1;
  min-width: 0;
}
.pending-task .card-title {
  margin-bottom: 2px;
}
