.home-hero {
  padding: 22px 20px;
  border-radius: 20px;
  background: #176747;
  color: #fff;
  box-shadow: 0 8px 22px rgba(23, 103, 71, 0.12);
}
.home-caption {
  font-size: 18px;
  color: #eef7e9;
}
.home-identity {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  margin: 12px 0;
}
.home-name {
  font-size: 27px;
  line-height: 1.4;
  font-weight: 700;
  overflow-wrap: anywhere;
}
.role-badge {
  padding: 4px 10px;
  border-radius: 9px;
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  font-size: 18px;
}
.task-overview {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 18px;
  margin-top: 16px;
  background: #fff;
  border: 1px solid #dce7dc;
  border-radius: 18px;
}
.task-overview > view:first-child {
  flex: 1;
  min-width: 0;
}
.overview-label {
  font-size: 20px;
  font-weight: 700;
  margin-bottom: 4px;
}
.overview-count {
  flex-shrink: 0;
  color: #176747;
  font-size: 36px;
  font-weight: 700;
  line-height: 1.3;
}
.overview-count text {
  font-size: 18px;
  font-weight: 400;
  margin-left: 6px;
}
.task-button {
  min-height: 96px;
  padding: 16px;
  justify-content: flex-start;
  gap: 12px;
  text-align: left;
}
.task-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 42px;
  height: 42px;
  flex: 0 0 42px;
  border-radius: 13px;
  background: #edf5e9;
  font-size: 24px;
  font-weight: 700;
}
.primary .task-icon {
  background: rgba(255, 255, 255, 0.16);
}
.task-copy {
  flex: 1;
  min-width: 0;
}
.task-title {
  font-size: 22px;
  line-height: 1.45;
}
.task-description {
  font-size: 18px;
  font-weight: 400;
  color: #51664f;
  line-height: 1.5;
  margin-top: 5px;
}
.primary .task-description {
  color: #eef7e9;
}
.task-arrow {
  flex-shrink: 0;
  font-size: 30px;
  font-weight: 400;
  line-height: 1;
}
.shortcut-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}
.shortcut-grid button {
  width: calc(50% - 6px);
  min-height: 72px;
  font-size: 18px;
  padding: 14px 10px;
}
.pending-task {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 16px 18px;
  margin-bottom: 12px;
  text-align: left;
}
.pending-copy {
  flex: 1;
  min-width: 0;
}
.pending-task .card-title {
  margin-bottom: 5px;
}
.guide-card {
  margin-top: 22px;
}
