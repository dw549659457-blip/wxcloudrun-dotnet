<view class="page"
  ><view class="title">{{name ? name + '，您好' : '今天记什么？'}}</view
  ><view class="subtitle">{{roleName ? '当前身份：' + roleName : '请选择本次身份'}}</view
  ><view wx:if="{{loading}}" class="notice">正在核实身份与任务…</view
  ><view wx:if="{{error}}" class="error">{{error}}<button bindtap="retry">重新加载</button></view>
  <view wx:if="{{selecting && !loading}}"
    ><button
      wx:for="{{roles}}"
      wx:key="value"
      class="primary"
      data-role="{{item.value}}"
      bindtap="chooseRole"
    >
      我是{{item.label}}</button
    ><view wx:if="{{!roles.length}}" class="notice"
      >此账号只有管理员身份，请使用网页管理后台。</view
    ></view
  >
  <view wx:if="{{guided && role}}" class="card"
    ><view class="card-title">第一次使用</view
    ><view>先选姓名与品类 → 填本次数量 → 核对后确认记账。</view
    ><view class="row-actions"
      ><button data-url="/pages/help/index" bindtap="navigate">看操作图解</button
      ><button bindtap="dismissGuide">我知道了</button></view
    ></view
  >
  <view wx:if="{{role === 'DRIVER'}}"
    ><view class="notice">还有 {{pendingCount}} 户任务没收完</view
    ><view class="actions"
      ><button class="primary" data-url="/pages/dispatch/index" bindtap="navigate">派发包装</button
      ><button data-url="/pages/batches/index?for=recovery" bindtap="navigate">
        回收包装和蔬菜</button
      ><view class="section-title">优先回收这些棚户</view
      ><button
        wx:for="{{pendingBatches}}"
        wx:key="id"
        class="card"
        data-url="/pages/recovery/index?batchId={{item.id}}"
        bindtap="navigate"
      >
        <view class="card-title">{{item.growerName}}</view
        ><view>{{item.date}} · 还没收完</view></button
      ><button data-url="/pages/batches/index?for=view" bindtap="navigate">查看全部棚户任务</button
      ><button data-url="/pages/records/index?resource=dispatches" bindtap="navigate">
        我的派发记录</button
      ><button data-url="/pages/records/index?resource=recoveries" bindtap="navigate">
        我的回收记录
      </button></view
    ></view
  >
  <view wx:if="{{role === 'WORKER'}}"
    ><view class="notice">当前 {{pendingCount}} 个棚户任务可以装菜</view
    ><view class="actions"
      ><button class="primary" data-url="/pages/work/index" bindtap="navigate">装菜登记</button
      ><button data-url="/pages/records/index?resource=work-records" bindtap="navigate">
        我的记录
      </button></view
    ></view
  >
  <view wx:if="{{role === 'OUTBOUND'}}" class="actions"
    ><button class="primary" data-url="/pages/outbound/index?mode=NORMAL" bindtap="navigate">
      正常出库</button
    ><button data-url="/pages/outbound/index?mode=DIRECT" bindtap="navigate">手工出库</button
    ><button data-url="/pages/inventory/index" bindtap="navigate">查看蔬菜库存</button
    ><button data-url="/pages/records/index?resource=outbounds" bindtap="navigate">
      我的出库记录
    </button></view
  >
  <button class="link-button" data-url="/pages/profile/index" bindtap="navigate">
    我的身份和帮助
  </button>
</view>
