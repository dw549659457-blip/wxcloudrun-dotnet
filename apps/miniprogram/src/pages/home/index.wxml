<view class="page">
  <view class="home-hero"><view class="home-caption">棚户记账 · 工作台</view><view class="home-identity"><view class="home-name">{{name ? name + '，您好' : '今天记什么？'}}</view><view class="role-badge" wx:if="{{roleName}}">{{roleName}}</view></view></view>
  <view wx:if="{{loading}}" class="notice">正在核实身份与任务…</view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="retry">重新加载</button></view>
  <view wx:if="{{selecting && !loading && !error}}" class="card"><view class="card-title">选择本次岗位</view><view class="actions"><button wx:for="{{roles}}" wx:key="value" class="primary" data-role="{{item.value}}" bindtap="chooseRole">我是{{item.label}}</button></view></view>
  <view wx:if="{{role && !loading && !error}}">
    <view wx:if="{{overviewError}}" class="notice">{{overviewError}}<button bindtap="retry">重试查询</button></view>
    <view class="task-overview" wx:if="{{role === 'DRIVER' || role === 'WORKER'}}"><view class="overview-label">{{role === 'DRIVER' ? '待回收棚户' : '可装菜任务'}}</view><view class="overview-count">{{overviewLoading || overviewError ? '…' : pendingCount}}<text>户</text></view></view>
    <view wx:if="{{role === 'DRIVER'}}">
      <view class="actions"><button class="task-button primary" data-url="/pages/dispatch/index" bindtap="navigate"><view class="task-copy"><view class="task-title">＋ 新建派发任务</view><view class="task-description">选棚户，填本次包装</view></view></button><button class="task-button" data-url="/pages/batches/index?for=recovery" bindtap="navigate"><view class="task-copy"><view class="task-title">回收包装与蔬菜</view><view class="task-description">填回收包装与实收蔬菜</view></view></button></view>
      <view class="section-title" wx:if="{{pendingBatches.length}}">优先回收</view>
      <button wx:for="{{pendingBatches}}" wx:key="id" class="pending-task" data-url="/pages/recovery/index?batchId={{item.id}}" bindtap="navigate"><view class="pending-copy"><view class="card-title">{{item.growerName}}</view><view class="caption">{{item.date}} · 还没收完</view></view><text class="task-arrow">›</text></button>
      <view class="section-title">查询与记录</view><view class="shortcut-grid"><button data-url="/pages/batches/index?for=view" bindtap="navigate">全部任务</button><button data-url="/pages/records/index?resource=dispatches" bindtap="navigate">派发记录</button><button data-url="/pages/records/index?resource=recoveries" bindtap="navigate">回收记录</button><button data-url="/pages/profile/index" bindtap="navigate">我的身份</button></view>
    </view>
    <view wx:if="{{role === 'WORKER'}}"><view class="actions"><button class="task-button primary" data-url="/pages/work/index" bindtap="navigate"><view class="task-copy"><view class="task-title">装菜登记</view><view class="task-description">填本次包装消耗与装菜量</view></view></button></view><view class="notice" wx:if="{{!overviewLoading && !overviewError && pendingCount === 0}}">暂无任务：请司机先派发包装并记账。</view><view class="section-title">查询与帮助</view><view class="shortcut-grid"><button data-url="/pages/records/index?resource=work-records" bindtap="navigate">装菜记录</button><button data-url="/pages/profile/index" bindtap="navigate">我的身份</button></view></view>
    <view wx:if="{{role === 'OUTBOUND'}}"><view class="actions"><button class="task-button primary" data-url="/pages/outbound/index?mode=NORMAL" bindtap="navigate"><view class="task-copy"><view class="task-title">正常出库</view><view class="task-description">选客户，填出库量</view></view></button><button class="task-button" data-url="/pages/outbound/index?mode=DIRECT" bindtap="navigate"><view class="task-copy"><view class="task-title">手工出库</view><view class="task-description">填写来源与出库量</view></view></button></view><view class="section-title">库存与记录</view><view class="shortcut-grid"><button data-url="/pages/inventory/index" bindtap="navigate">蔬菜库存</button><button data-url="/pages/records/index?resource=outbounds" bindtap="navigate">出库记录</button><button data-url="/pages/profile/index" bindtap="navigate">我的身份</button><button data-url="/pages/help/index" bindtap="navigate">操作帮助</button></view></view>
  </view>
  <button class="link-button" wx:if="{{role === 'DRIVER' || role === 'WORKER'}}" data-url="/pages/help/index" bindtap="navigate">操作帮助</button>
</view>
