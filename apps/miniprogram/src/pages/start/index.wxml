<view class="page">
  <view class="title">棚户记账</view><view class="subtitle">派发 · 装菜 · 回收 · 出库</view>
  <view class="card"
    ><view class="card-title">先确认您是谁</view
    ><view>管理员先登记员工，再用本人微信和手机号绑定。以后打开可直接进入。</view></view
  >
  <view class="error" wx:if="{{error}}">{{error}}</view
  ><view class="notice" wx:if="{{notice}}">{{notice}}</view>
  <view class="actions" wx:if="{{stage === 'START'}}"
    ><button class="primary" bindtap="begin" loading="{{loading}}" disabled="{{loading}}">
      开始使用
    </button></view
  >
  <view wx:if="{{stage === 'PHONE'}}"
    ><view class="section-title">用本人手机号核实</view
    ><button
      class="primary"
      open-type="getPhoneNumber"
      bindgetphonenumber="phone"
      loading="{{loading}}"
      disabled="{{loading}}"
    >
      用微信手机号开始使用</button
    ><button class="link-button" bindtap="notMe">手机号不匹配，找管理员协助</button></view
  >
  <view wx:if="{{stage === 'CONFIRM'}}"
    ><view class="card"
      ><view class="caption">请核对下面身份</view><view class="card-title">{{candidate}}</view
      ><view>确认后，此微信会绑定到这位员工。</view></view
    ><view class="actions"
      ><button class="primary" bindtap="confirm" loading="{{loading}}" disabled="{{loading}}">
        是我，确认绑定</button
      ><button bindtap="notMe" disabled="{{loading}}">不是我，联系管理员</button></view
    ></view
  >
  <view wx:if="{{stage === 'ASSIST' || assistance}}"
    ><button class="primary" bindtap="requestHelp" disabled="{{loading}}" loading="{{loading}}">
      申请管理员协助绑定
    </button></view
  >
  <view wx:if="{{stage === 'WAITING'}}"
    ><button class="primary" bindtap="checkHelp" disabled="{{loading}}" loading="{{loading}}">
      查看核实结果
    </button></view
  >
  <button class="link-button" bindtap="contact">联系管理员</button>
  <view class="card" wx:if="{{development}}"
    ><view class="card-title">仅本地开发验证</view><view>正式发布使用上方微信进入。</view
    ><input
      value="{{username}}"
      data-field="username"
      bindinput="field"
      placeholder="开发账号"
    /><input
      password="true"
      value="{{password}}"
      data-field="password"
      bindinput="field"
      placeholder="开发密码"
    /><button bindtap="developmentLogin" disabled="{{loading}}">本地验证登录</button></view
  >
</view>
